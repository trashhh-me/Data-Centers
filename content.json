  "movements": [
    {
      "id": "1",
      "name": "Your photo",
      "color": "#AF9ED7",
      "visual": "journey",
      "steps": [
        {
          "id": "1.1",
          "title": "You send a photo.",
          "state": "send",
          "photo": true
        },
        {
          "id": "1.2",
          "title": "It flies through the air, then cables, then glass.",
          "state": "travel",
          "photo": true,
          "drawer": "glass",
          "source": {
            "label": "How glass carries light"
          }
        },
        {
          "id": "1.3",
          "title": "People say it goes to “the cloud.”",
          "state": "cloud",
          "photo": true
        },
        {
          "id": "1.4",
          "title": "But the cloud is a building.",
          "state": "building",
          "photo": true
        }
      ]
    },
    {
      "id": "2",
      "name": "Inside",
      "color": "#77C0F7",
      "visual": "cutaway",
      "steps": [
        {
          "id": "2.1",
          "title": "Inside: rows of computers that never switch off.",
          "state": "racks",
          "lit": "compute",
          "photo": true
        },
        {
          "id": "2.2",
          "title": "Your photo is saved on one of them.",
          "state": "server",
          "lit": "compute",
          "photo": true,
          "interactive": true,
          "hint": "Tap a rack to look inside."
        },
        {
          "id": "2.3",
          "title": "Those computers need power, every second.",
          "state": "power",
          "lit": "compute power backup",
          "photo": true,
          "interactive": true,
          "drawer": "powercut",
