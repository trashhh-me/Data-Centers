  "drawers": {
    "glass": {
      "title": "How glass carries light",
      "blocks": [
        {
          "h": "Pulses of light",
          "p": "A machine switches a light on and off very fast. Each pattern of flashes stands for ones and zeros."
        },
        {
          "h": "Down a strand of glass",
          "p": "The light stays inside the strand all the way to the far end. A receiver turns the flashes back into your photo."
        }
      ]
    },
    "powercut": {
      "title": "What happens in a power cut",
      "blocks": [
        {
          "h": "The first minutes",
          "p": "Batteries take over at once, so the computers do not stop."
        },
        {
          "h": "Then, for hours",
          "p": "Diesel generators start and keep the building running until the power comes back."
        }
      ]
    },
    "water": {
      "title": "Where the water goes",
      "blocks": [
        {
          "h": "Cooling towers",
          "p": "Many data centers cool the air by letting water evaporate in a cooling tower, the way sweat cools skin."
        },
        {
          "h": "What happens to the water",
          "p": "Most of it evaporates. It does not go back into the river or the pipe."
        }
      ]
    },
    "aiRack": {
      "title": "Normal and AI racks",
      "blocks": [
        {
          "h": "The numbers",
          "p": "A normal rack of computers uses about 15 kW. A rack built for AI needs 60 to 120 kW, which is 4 to 8 times more."
        },
        {
          "h": "How firm is this?",
          "p": "These are industry estimates and vary between buildings, so we say “about”."
        }
      ],
      "cite": "CoreSite, industry estimate."
    },
    "aiHomes": {
      "title": "100,000 homes",
      "blocks": [
        {
          "h": "The comparison",
          "p": "A typical data center built for AI uses as much electricity as 100,000 households. The largest ones now being built use 20 times more."
        },
        {
          "h": "How to read the dots",
          "p": "Each dot on the screen stands for 500 homes. There are 200 dots."
        }
      ],
      "cite": "International Energy Agency (2025). Energy and AI. IEA, Paris."
    },
    "aiWorld": {
      "title": "Twice as much by 2030",
      "blocks": [
        {
          "h": "2024",
          "p": "Data centers used about 415 TWh of electricity, about 1.5% of all the electricity in the world."
        },
        {
          "h": "2030 (projected)",
          "p": "About 945 TWh, a little more than double. This is a projection, not a measurement."
        },
        {
          "h": "What is a TWh?",
          "p": "One TWh is one billion kilowatt-hours."
        }
      ],
      "cite": "International Energy Agency (2025). Energy and AI. IEA, Paris."
    },
    "directive": {
      "title": "Keeping data in Nepal",
      "blocks": [
        {
          "h": "The rule",
          "p": "Since 2025, providers must register with the Department of Information Technology under the Data Center and Cloud Service Directives."
        }
      ],
      "cite": "Kantipur, February 2025."
    },
    "unused": {
      "title": "Why the power goes unused",
      "blocks": [
        {
          "h": "Making more than we use",
          "p": "Nepal's power plants can make about 4,300 MW. At its busiest, the country uses about 2,200 MW. So it can make nearly twice what it uses at peak."
        },
        {
          "h": "In the monsoon",
          "p": "Rivers run full and plants make the most power, but demand does not rise to match. An industry body estimates that up to about 900 MW may go unused."
        },
        {
          "h": "Who says so",
          "p": "The 900 MW figure is an industry body's estimate, not a government number."
        }
      ],
      "cite": "Kathmandu Post, July 2026."
    },
    "budget": {
      "title": "What the plan says",
      "blocks": [
        {
          "h": "The budget for 2026/27",
          "p": "It says Nepal will “convert Nepal's hydroelectric energy into high-value AI compute services, creating skilled employment and enabling digital exports.”"
        },
        {
          "h": "A claim, not a result",
          "p": "This is what the plan promises. How many jobs and how much export will follow is not yet known."
        }
      ],
      "cite": "Nepal News, budget explainer."
    },
    "cobalt": {
      "title": "Cobalt and child labour",
      "blocks": [
        {
          "h": "Why cobalt",
          "p": "Cobalt goes into the batteries that power phones and laptops. Much of the world's cobalt is mined in the Democratic Republic of the Congo."
        },
        {
          "h": "What was found",
          "p": "In 2016 Amnesty International reported children as young as seven mining cobalt in the DR Congo."
        },
        {
          "h": "Tracing",
          "p": "A server passes through a mine, a factory and a ship. Each step belongs to a different company, so it is hard to trace one server back to one mine."
        }
      ],
      "cite": "Amnesty International (January 2016). This is what we die for. Reported by Mining Technology."
    },
    "footprint": {
      "title": "Energy before it runs",
      "blocks": [
        {
          "h": "A footprint before day one",
          "p": "Mining the metals, making the parts and shipping the server all use energy. That energy is used before the server does any work."
        }
      ],
      "cite": "Xiao et al., 2025."
    },
    "waterNum": {
      "title": "Water for cooling",
      "blocks": [
        {
          "h": "The figure",
          "p": "A medium-sized data center can use about 1.14 million litres of water a day."
        }
      ],
      "cite": "Nepal News. A secondary source."
    },
    "trishuli": {
      "title": "Upper Trishuli-1",
      "blocks": [
        {
          "h": "The project",
          "p": "A 216 MW hydropower plant in Rasuwa district."
        },
        {
          "h": "What a study counted",
          "p": "1,646 households, or 7,181 people, mostly Tamang, live in the affected area. The communities raised concerns about whether they gave free, prior and informed consent."
        },
        {
          "h": "Whose account this is",
          "p": "This is the account of LAHURNIP, an Indigenous-rights group, which is an advocacy group."
        },
        {
          "h": "Response from the developer and lender",
          "p": "[to be added before launch]",
          "pending": true
        }
      ],
      "cite": "LAHURNIP."
    },
    "ewaste": {
      "title": "E-waste",
      "blocks": [
        {
          "h": "Worldwide, 2022",
          "p": "62 million tonnes of e-waste. Only 22.3% was formally recycled, about 1 in 5."
        },
        {
          "h": "Formally recycled",
          "p": "Collected and recycled in a way that is recorded. The rest is not tracked."
        }
      ],
      "cite": "Global E-waste Monitor 2024."
    },
    "rules": {
      "title": "No rules yet",
      "blocks": [
        {
          "h": "As of April 2026",
          "p": "Data centers are not on the list that requires a full environmental impact assessment. Nobody has to monitor their water, noise or heat."
        }
      ],
      "cite": "Kathmandu Post, April 2026."
    },
    "mapToday": {
      "title": "Where they are",
      "blocks": [
        {
          "h": "As of 2025, in the Kathmandu Valley",
          "p": "Government Integrated Data Centre, NEA Suchatar, Ncell Nakhu and WorldLink Chandragiri."
        },
        {
          "h": "Backup sites",
          "p": "Hetauda and Pokhara. A backup site keeps a copy of the data far away, in case the main building fails."
        },
        {
          "h": "What counts?",
          "p": "A company, a building and a backup site are all called a “data center”. The number depends on what you count."
        }
      ],
      "cite": "Himalayan Times 2019; Kathmandu Post 2025; DCD 2024, 2025."
    },
    "mapPlanned": {
      "title": "What is planned",
      "blocks": [
        {
          "h": "Syuchatar",
          "p": "A Sovereign AI Computing Center, announced in the May 2026 budget. The exact site has not been shared, so only the area is marked."
        },
        {
          "h": "Bichuten Data Vault",
          "p": "In Kathmandu and Birgunj. 240 kW now, growing to 5 MW by 2030."
        },
        {
          "h": "Backups",
          "p": "Nepal Telecom at Bhairahawa. Nepal Electricity Authority at Butwal."
        }
      ],
      "cite": "Nepal News; DCD, May 2026; DCD 2024 and 2025."
    }
  },
